{
	"name": "hexa.blue",
	"version": "0.0.1",
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261027.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"wrangler": "^4.153.0"
	},
	"private": true,
	"scripts": {
		"locales:sync": "bun scripts/sync-locales.mjs",
		"dev": "bun run locales:sync && vite dev",
		"build": "bun run locales:sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run locales:sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run locales:sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:e2e"
	},
	"type": "module",
	"dependencies": {
		"@types/sanitize-html": "^2.16.2",
		"sanitize-html": "^2.18.1"
	}
}
